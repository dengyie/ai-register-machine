# typesafe provider — copy env, do not commit secrets
#
# Education / personal automation only. Default COUNT=1.
# Do not copy the original farm defaults (ACCOUNT_COUNT=512 / CONCURRENCY=256).

# TYPESAFE_EMAIL_SOURCE=tinyhost
# TYPESAFE_OTP_TIMEOUT=180
# TYPESAFE_API_KEY_NAME=register-core

# Optional fixed URL (mainly with REGISTER_EGRESS=clash or direct override)
# TYPESAFE_PROXY=http://127.0.0.1:7897

# HTTP/SOCKS pool (REGISTER_EGRESS=list|auto)
# TYPESAFE_PROXY_LIST=http://user:pass@1.2.3.4:8080
# REGISTER_NODES_FILE=./nodes.json
